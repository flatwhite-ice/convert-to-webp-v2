# PyInstaller 빌드 산출물 (build.py 가 매 실행마다 새로 만든다)
build/
dist/
*.spec

# releases/ 는 의도적으로 추적합니다 — README 다운로드 링크가 가리키는 배포 zip 보관소.
# 새 빌드를 배포하려면 dist/convert-to-webp2-<os>.zip 을 releases/ 로 복사한 뒤 커밋하세요.

# Python 가상환경 / 캐시
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.Python

# 에디터 / OS 메타데이터
.DS_Store
Thumbs.db
